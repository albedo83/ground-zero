[Unit]
Description=GROUND//ZERO global detonation counter
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/ground-zero-counter/counter.py
Environment=GZ_HOST=127.0.0.1 GZ_PORT=8787
# utilisateur éphémère sans droits ; seul /var/lib/ground-zero est inscriptible
DynamicUser=yes
StateDirectory=ground-zero
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryMax=64M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
